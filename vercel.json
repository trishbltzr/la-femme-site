{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.lafemmefashion.com/",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "la-femme-site.vercel.app"
        }
      ]
    },
    {
      "source": "/index.html",
      "destination": "https://www.lafemmefashion.com/",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "la-femme-site.vercel.app"
        }
      ]
    },
    {
      "source": "/contact.html",
      "destination": "https://www.lafemmefashion.com/pages/contact",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "la-femme-site.vercel.app"
        }
      ]
    },
    {
      "source": "/contact",
      "destination": "https://www.lafemmefashion.com/pages/contact",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "la-femme-site.vercel.app"
        }
      ]
    },
    {
      "source": "/contact/",
      "destination": "https://www.lafemmefashion.com/pages/contact",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "la-femme-site.vercel.app"
        }
      ]
    },
    {
      "source": "/:path(.*)",
      "destination": "https://www.lafemmefashion.com/:path*",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "la-femme-site.vercel.app"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/:path(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
